# --- LLM: pick ONE option and fill in its key -------------------------------
# Option A (default): Google Gemini, free API key from https://aistudio.google.com/apikey
LLM_MODEL=google_genai:gemini-3.5-flash-lite
GOOGLE_API_KEY=

# Option B: Groq, free API key from https://console.groq.com/keys
# LLM_MODEL=groq:llama-3.3-70b-versatile
# GROQ_API_KEY=

# Option C: Ollama, runs on your PC, no key (install from https://ollama.com,
# then run: ollama pull qwen2.5:7b)
# LLM_MODEL=ollama:qwen2.5:7b

# Paid options
# LLM_MODEL=openai:gpt-4.1-mini
# OPENAI_API_KEY=
# LLM_MODEL=anthropic:claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- Retrieval: dense (local fastembed model) or bm25 (no download) ---
RETRIEVER=dense
# MIN_SCORE_DENSE=0.55
# MIN_SCORE_BM25=2.0

# --- WhatsApp: Meta Cloud API (recommended, free test number) ---
# App Dashboard > WhatsApp > API Setup: access token + Phone number ID
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# App settings > Basic > App secret (verifies incoming webhooks)
META_APP_SECRET=
# Any string you invent; paste the same value as "Verify token" in Meta's webhook settings
META_VERIFY_TOKEN=
# Graph API version used to send replies; match the version in the API Setup sample (e.g. v25.0)
META_GRAPH_VERSION=v25.0

# auto = Meta if configured, else Twilio. Or force: meta / twilio
WHATSAPP_PROVIDER=auto

# --- WhatsApp: Twilio (alternative; trial accounts can't send free-form replies) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true
# The public https URL of this service, with https:// (ngrok or Render URL)
PUBLIC_BASE_URL=

# --- Staff console (/admin). Leave empty to disable the admin API. ---
ADMIN_TOKEN=change-me-to-a-long-random-string

LOG_LEVEL=INFO
